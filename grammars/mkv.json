      "0x536E": "8", "0x22B59C": "s", "0x22B59D": "s", "0x86": "s", "0x63A2": "b", "0x258688": "8", "0x56AA": "u", "0x56BB": "u",
      "0xE0": "m", "0xB0": "u", "0xBA": "u", "0x54B0": "u", "0x54BA": "u", "0x9A": "u", "0x55B0": "m",
      "0xE1": "m", "0xB5": "f", "0x9F": "u", "0x6264": "u", "0x6D80": "m", "0x6240": "m",
