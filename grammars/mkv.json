{
  "id": "mkv",
  "name": "Matroska / WebM (EBML)",
  "doc": "Matroska (MKV, MKA) and WebM are built on EBML, a binary XML. Every element is: an ID (1-4 byte variable-length integer that keeps its length marker), a size (1-8 byte vint; all-ones means 'unknown', used by live streams), then data. Master elements contain other elements. The first element is the EBML header (DocType = matroska or webm), then one Segment holding SeekHead, Info, Tracks, Clusters (the media blocks), Cues (the seek index) and Tags.",
  "extensions": ["mkv", "mka", "mks", "mk3d", "webm"],
  "mime": "video/x-matroska",
  "magic": [{ "offset": 0, "hex": "1A 45 DF A3" }],
  "endian": "big",
  "preview": "media",
  "root": [
    { "name": "elements", "type": "element", "repeat": "eof" }
  ],
  "structs": {
    "element": {
      "label": "${enumName('ebmlName', id) || hex(id)}${has(body) && enumName('ebmlType', id) != 'm' && enumName('ebmlType', id) != 'b' && enumName('ebmlType', id) ? ' = ' + str(body) : ''}${enumName('ebmlType', id) == 'm' || enumName('ebmlType', id) == 'b' || !enumName('ebmlType', id) ? ' · ' + _length + ' B' : ''}",
      "colorBy": "id",
      "fields": [
        { "name": "id", "type": "ebmlid", "format": "hex", "enum": "ebmlName" },
        { "name": "size", "type": "vint", "doc": "Data size. -1 = unknown (element extends until a parent-level element appears)." },
        { "name": "body", "type": "switch", "size": "size == -1 ? _remaining : size",
          "on": "enumName('ebmlType', id) || 'b'",
          "cases": {
            "m": "master",
            "u": "uint",
            "i": "sint",
            "d": { "type": "sint", "doc": "Date: nanoseconds since 2001-01-01T00:00:00 UTC" },
            "f": "float",
            "s": "string",
            "8": { "type": "string", "encoding": "utf-8" },
            "b": "bytes"
          } }
      ]
    },
    "master": { "fields": [ { "name": "children", "type": "element", "repeat": "eof" } ] }
  },
  "enums": {
    "ebmlName": {
      "0x1A45DFA3": "EBML", "0x4286": "EBMLVersion", "0x42F7": "EBMLReadVersion", "0x42F2": "EBMLMaxIDLength", "0x42F3": "EBMLMaxSizeLength",
      "0x4282": "DocType", "0x4287": "DocTypeVersion", "0x4285": "DocTypeReadVersion", "0xEC": "Void", "0xBF": "CRC-32",
      "0x18538067": "Segment", "0x114D9B74": "SeekHead", "0x4DBB": "Seek", "0x53AB": "SeekID", "0x53AC": "SeekPosition",
      "0x1549A966": "Info", "0x2AD7B1": "TimestampScale", "0x4489": "Duration", "0x4461": "DateUTC", "0x7BA9": "Title",
      "0x4D80": "MuxingApp", "0x5741": "WritingApp", "0x73A4": "SegmentUUID",
